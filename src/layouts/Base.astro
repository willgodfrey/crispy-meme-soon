---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBand from '../components/ContactBand.astro';
import { common } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  invitation?: boolean;
  noindex?: boolean;
  bodyClass?: string;
}
const { title, description, invitation = true, noindex = false, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const share = common.share;
const ogImage = new URL(share.image, Astro.site).href;
// Analytics runs in production only; local/private review sends nothing.
const analytics = import.meta.env.PUBLIC_ENABLE_ANALYTICS === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/manrope-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={share.imageAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class:list={[bodyClass]}>
    <a class="skip" href="#main">{common.accessibility.skipLink}</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {invitation ? <ContactBand /> : <SiteFooter />}
    {
      analytics && (
        <Fragment>
          <script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=G-RQMR51RTHC" />
          <script is:inline defer src="/ga.js" />
        </Fragment>
      )
    }
  </body>
</html>
