---
import '@fontsource-variable/bricolage-grotesque';
import '../styles/tokens.css';
import '../styles/base.css';
import { getSite } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  sheet?: string;
  revision?: number;
  revised?: string;
}
const { title, description, sheet, revision = 1, revised = '[[TODO: launch date]]' } = Astro.props;
const site = await getSite();
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/images/will-godfrey.jpg', Astro.site).href;
const isTodo = (v: string) => v.includes('[[TODO');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="/">{site.siteName}</a>
      <nav aria-label="Primary">
        {
          site.nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <section aria-label="About Will Godfrey">
        <p class="bio">{site.closingBlock}</p>
        <p class="bio-link"><a href="/contact/">{site.closingLink}</a></p>
      </section>
      <div class="meta">
        <p>{site.titleBlock.practice}</p>
        <p>{site.location}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href={site.linkedin}>LinkedIn</a></p>
        <p class="push">
          {sheet}, revision {revision},
          {' '}
          {isTodo(revised) ? <span class="todo">{revised}</span> : <span>{revised}</span>}
        </p>
      </div>
    </footer>

    <!-- Google Analytics: the single third-party script, loaded last per site owner. -->
    <script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=G-RQMR51RTHC"
    ></script>
    <script is:inline defer src="/ga.js"></script>
  </body>
</html>
