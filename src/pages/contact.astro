---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import AssemblyPicture from '../components/AssemblyPicture.astro';
import '../styles/inner.css';
import { contact, common } from '../lib/content';
const d = contact.details;
---

<Base
  title={contact.seo.title}
  description={contact.seo.description}
  invitation={false}
  bodyClass="inner-page"
>
  <section class="contact-canvas">
    <div class="contact-message">
      <p class="page-kicker">{contact.hero.eyebrow}</p>
      <h1>{contact.hero.titleLines.map((l: string, i: number) => (i ? [<br />, l] : l))}</h1>
      <p class="lead">{contact.hero.body}</p>
    </div>
    <div class="contact-direct">
      <AssemblyPicture class="contact-detail" sizes="(max-width: 620px) 100vw, 50vw" />
      <div class="contact-copy">
        <p class="email-label">{contact.expectations.title}</p>
        <a class="email-link" href={contact.hero.primaryLink.href}>{contact.hero.primaryLink.label}</a>
        <p class="contact-expectation">{contact.expectations.paragraphs[0]}</p>
        <p class="availability">{contact.expectations.paragraphs[1]}</p>
        <p class="email-help">{d.emailHelp}</p>
      </div>
    </div>
  </section>

  <section class="contact-prompt-row wrap">
    <div>
      <p class="page-kicker">{contact.prompts.eyebrow}</p>
      <h2>{contact.prompts.title}</h2>
      <p>{contact.prompts.body}</p>
    </div>
    <div>
      <ul class="contact-prompts" role="list">
        {contact.prompts.items.map((p: string) => <li>{p}</li>)}
      </ul>
      <p class="location-info">{d.locationLabel}: {d.location}. {d.working}</p>
      <TextLink href={common.linkedin.href} label={d.linkedinLabel} />
    </div>
  </section>

</Base>
