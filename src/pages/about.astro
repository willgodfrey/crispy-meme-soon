---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import '../styles/inner.css';
import { about, common } from '../lib/content';
---

<Base title={about.seo.title} description={about.seo.description} bodyClass="inner-page">
  <section class="inner-intro about-opening wrap">
    <div>
      <p class="page-kicker">{about.hero.eyebrow}</p>
      <h1>{about.hero.titleLines.map((l: string, i: number) => (i ? [<br />, l] : l))}</h1>
      <p class="lead">{about.hero.body}</p>
    </div>
    <figure class="about-portrait">
      <img src={common.portrait.path} alt={common.portrait.alt} width="320" height="360" loading="lazy" />
      <figcaption>
        <strong>{common.siteName}</strong>{about.hero.portraitCaption}
      </figcaption>
    </figure>
  </section>

  <section class="career-arc wrap">
    {
      about.arc.items.map((a: { title: string; label: string; body: string }) => (
        <article>
          <p class="arc-label">{a.label}</p>
          <h2>{a.title}</h2>
          <p>{a.body}</p>
        </article>
      ))
    }
  </section>

  <section class="biography white wrap">
    <div class="bio-aside">
      <h2 class="large">{about.opening.title}</h2>
    </div>
    <div class="bio-copy">
      {about.opening.paragraphs.map((p: string) => <p>{p}</p>)}
    </div>
  </section>

  <section class="biography wrap">
    <div class="bio-aside">
      <h2>{about.technicalSeat.title}</h2>
      <p class="page-kicker">{about.technicalSeat.eyebrow}</p>
    </div>
    <div class="bio-copy">
      {about.technicalSeat.paragraphs.map((p: string) => <p>{p}</p>)}
      <TextLink href={about.technicalSeat.link.href} label={about.technicalSeat.link.label} />
    </div>
  </section>

  <section class="about-pullquote wrap">
    <div>
      <p class="quote-label">{about.photographer.eyebrow}</p>
    </div>
    <div>
      <blockquote>{about.photographer.title}</blockquote>
      {about.photographer.paragraphs.map((p: string) => <p>{p}</p>)}
    </div>
  </section>

  <section class="biography white wrap">
    <div class="bio-aside">
      <p class="page-kicker">{about.today.eyebrow}</p>
      <h2>{about.today.title}</h2>
      <dl class="today-facts">
        {
          about.today.facts.map((f: { label: string; value: string }) => [
            <dt>{f.label}</dt>,
            <dd>{f.value}</dd>,
          ])
        }
      </dl>
    </div>
    <div class="bio-copy">
      {about.today.paragraphs.map((p: string) => <p>{p}</p>)}
      <TextLink href={about.today.link.href} label={about.today.link.label} />
    </div>
  </section>
</Base>
