---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import '../styles/practice.css';
import { practice, common, getStages } from '../lib/content';

const stages = getStages(practice.engagement.stageIds);
const layers = practice.layers.items as {
  id: string;
  title: string;
  question: string;
  body: string;
  joint: string;
}[];
---

<Base title={practice.seo.title} description={practice.seo.description}>
  <section class="practice-hero wrap">
    <div class="practice-title">
      <p class="page-kicker">{practice.hero.eyebrow}</p>
      <h1>{practice.hero.titleLines.map((l: string, i: number) => (i ? [<br />, l] : l))}</h1>
      <p class="practice-summary">{practice.hero.body}</p>
      <div class="hero-links">
        <TextLink href={practice.hero.primaryLink.href} label={practice.hero.primaryLink.label} />
        <TextLink href={practice.hero.secondaryLink.href} label={practice.hero.secondaryLink.label} />
      </div>
    </div>
    <div>
      <div class="layer-art">
        <svg id="venture-model" viewBox="0 0 680 595" role="img" aria-labelledby="model-title model-description"><style>{`.plane-face{fill:#bdc6bc;fill-opacity:.16;stroke:#6c796b;stroke-width:1}.plane-edge{fill:#bdc6bc;fill-opacity:.2;stroke:#7e8b7b;stroke-width:1}.plane-detail{fill:none;stroke:#667163;stroke-width:1.2;stroke-opacity:.7}.plane-solid{fill:#b7c3b2;fill-opacity:.6;stroke:#7b8a77;stroke-width:1}.layer.is-active .plane-face{fill:#622b3d;fill-opacity:.95;stroke:#622b3d}.layer.is-active .plane-edge{fill:#753e51;fill-opacity:1;stroke:#622b3d}.layer.is-active .plane-detail{stroke:#f7f5ef;stroke-opacity:.7}.layer.is-active .plane-solid{fill:#a97e8b;stroke:#e1c7d0;fill-opacity:.6}.support{stroke:#82907f;stroke-width:1;stroke-dasharray:3 5;fill:none;opacity:.6}.diagram-dot{fill:#622b3d}.callout{font:12px Manrope,Arial,sans-serif;fill:#414a40}.callout-line{fill:none;stroke:#727e70;stroke-width:1}.dimension{font:9px Arial,sans-serif;fill:#4a5648}`}</style>
          <title id="model-title">Three dimensions. One business.</title><desc id="model-description">An exploded architectural model with commercial, technical, and institutional planes. Each plane depends on the others. Choose a dimension below to explore the connection.</desc>
          <defs><pattern id="fine-grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0v25" fill="none" stroke="#b6caff" stroke-width=".65" opacity=".22"></path></pattern></defs>
          <path class="support" d="M340 63v194M600 213v194M340 363v194M80 213v194M470 138v194M210 138v194M210 288v194M470 288v194"></path>
          <g class="layer layer-institutional" data-plane="institutional">
            <path class="plane-edge" d="m80 399 260 150 260-150v17L340 566 80 416Z"></path>
            <g transform="matrix(.866 .5 -.866 .5 340 249)"><rect class="plane-face" width="300" height="300"></rect><rect class="plane-detail" x="16" y="16" width="268" height="268"></rect><path class="plane-detail" d="M16 100h268M16 200h268M100 16v268M200 16v268"></path><rect class="plane-solid" x="34" y="34" width="52" height="52"></rect><rect class="plane-solid" x="215" y="34" width="52" height="52"></rect><rect class="plane-solid" x="34" y="215" width="52" height="52"></rect><rect class="plane-solid" x="215" y="215" width="52" height="52"></rect><circle class="plane-detail" cx="150" cy="150" r="33"></circle><path class="plane-detail" d="M150 100v17m0 66v17m-50-50h17m66 0h17M122 122l56 56m0-56-56 56"></path></g>
          </g>
          <g class="layer layer-technical" data-plane="technical">
            <path class="plane-edge" d="m80 306 260 150 260-150v13L340 469 80 319Z"></path>
            <g transform="matrix(.866 .5 -.866 .5 340 156)"><rect class="plane-face" width="300" height="300"></rect><rect x="0" y="0" width="300" height="300" fill="url(#fine-grid)"></rect><path class="plane-detail" d="M25 25h250v250H25ZM100 25v80m100-80v80M25 150h60m130 0h60M100 275v-80m100 80v-80"></path><rect class="plane-solid" x="88" y="88" width="124" height="124"></rect><rect class="plane-detail" x="111" y="111" width="78" height="78"></rect><path class="plane-detail" d="M130 88V55h-20m40 33V40m20 48V55h20M212 130h33v-20m-33 40h48m-48 20h33v20M130 212v33h-20m40-33v48m20-48v33h20M88 130H55v-20m33 40H40m48 20H55v20M126 131h48v38h-48zM138 141h24v18h-24z"></path><circle class="plane-detail" cx="45" cy="45" r="7"></circle><circle class="plane-detail" cx="255" cy="45" r="7"></circle><circle class="plane-detail" cx="45" cy="255" r="7"></circle><circle class="plane-detail" cx="255" cy="255" r="7"></circle></g>
          </g>
          <g class="layer layer-commercial is-active" data-plane="commercial">
            <path class="plane-edge" d="m80 213 260 150 260-150v12L340 375 80 225Z"></path>
            <g transform="matrix(.866 .5 -.866 .5 340 63)"><rect class="plane-face" width="300" height="300"></rect><path class="plane-detail" d="M18 18h264v264H18Z"></path><path class="plane-detail" d="M18 106h98v-88M18 196h98v86M202 18v89h80M202 193v89h80"></path><rect class="plane-solid" x="35" y="35" width="64" height="53"></rect><rect class="plane-solid" x="35" y="214" width="64" height="50"></rect><rect class="plane-solid" x="219" y="35" width="46" height="53"></rect><rect class="plane-solid" x="219" y="212" width="46" height="52"></rect><circle class="plane-detail" cx="150" cy="150" r="52"></circle><circle class="plane-detail" cx="150" cy="150" r="37"></circle><path class="plane-detail" d="M98 150H40m162 0h63M150 98V35m0 167v63"></path><path class="plane-detail" d="m127 150 16 16 30-32"></path><path class="plane-detail" d="M45 47h44M45 59h31M45 71h38M45 227h44m-44 12h28m-28 12h35M231 47h22m-22 12h22m-22 12h14M231 226h22m-22 12h22m-22 12h14"></path></g>
          </g>
          <path class="callout-line" d="m471 140 61-35h98"></path><circle class="diagram-dot" cx="471" cy="140" r="2.5"></circle><text class="callout" x="548" y="94">Commercial</text>
          <path class="callout-line" d="m159 351-54 31H35"></path><circle class="diagram-dot" cx="159" cy="351" r="2.5"></circle><text class="callout" x="35" y="403">Technical</text>
          <path class="callout-line" d="m505 454 50 29h75"></path><circle class="diagram-dot" cx="505" cy="454" r="2.5"></circle><text class="callout" x="548" y="504">Institutional</text>
        </svg>
      </div>
      <div class="layer-controls case-controls js-controls" role="group" aria-label={common.accessibility.diagramSelector}>
        {
          layers.map((it, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`layer-${it.id}`} data-plane={it.id} data-target={`layer-${it.id}`}>
              {it.title}
            </button>
          ))
        }
      </div>
      <div class="layer-panels">
        {
          layers.map((it) => (
            <div class="layer-panel" id={`layer-${it.id}`}>
              <h2>{it.question}</h2>
              <p>{it.body}</p>
              <p class="joint">{it.joint}</p>
            </div>
          ))
        }
      </div>
      <p class="model-caption">{practice.layers.caption}</p>
    </div>
  </section>

  <section class="joins wrap">
    <h2>{practice.layers.title}</h2>
    <p>{practice.layers.body}</p>
  </section>

  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{practice.decisions.eyebrow}</p>
        <h2>{practice.decisions.title}</h2>
      </div>
      <p>{practice.decisions.body}</p>
    </div>
    <ul class="decision-list">
      {practice.decisions.items.map((d: string) => <li>{d}</li>)}
    </ul>
  </section>

  <section class="section engagement wrap" id={practice.engagement.id}>
    <div class="section-heading">
      <div>
        <p class="eyebrow">{practice.engagement.eyebrow}</p>
        <h2>{practice.engagement.title}</h2>
      </div>
      <p>{practice.engagement.body}</p>
    </div>
    <div class="stage-spreads">
      {
        stages.map((s) => (
          <article>
            <p class="phase-number">{s.number}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <h4>{s.deliverable.title}</h4>
            <ul>{s.deliverable.items.map((it: string) => <li>{it}</li>)}</ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section modes wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{practice.modes.eyebrow}</p>
        <h2>{practice.modes.title}</h2>
      </div>
      <p>{practice.modes.body}</p>
    </div>
    <div class="mode-grid">
      {
        practice.modes.items.map((m: { title: string; body: string; duration: string; location: string }) => (
          <article>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
            <p>{m.duration}</p>
            <p>{m.location}</p>
          </article>
        ))
      }
    </div>
    <div class="modes-foot">
      <p>{practice.modes.note}</p>
      <TextLink href={practice.modes.link.href} label={practice.modes.link.label} />
    </div>
  </section>

  <section class="section standards wrap">
    <div>
      <p class="eyebrow">{practice.standards.eyebrow}</p>
      <h2>{practice.standards.title}</h2>
      <ul>{practice.standards.items.map((s: string) => <li>{s}</li>)}</ul>
    </div>
    <div>
      <h3>{practice.standards.boundaryTitle}</h3>
      <ul>{practice.standards.boundaries.map((b: string) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="section definition wrap" id={practice.definition.id}>
    <aside>
      <p class="eyebrow">{practice.definition.eyebrow}</p>
      <h2>{practice.definition.title}</h2>
      <p>{practice.definition.byline}</p>
      <TextLink href="#questions" label={practice.faq.title} />
    </aside>
    <div class="reading">
      <p class="definition-lead">{practice.definition.introduction}</p>
      {
        practice.definition.sections.map((sec: { title: string; paragraphs: string[] }) => (
          <section>
            <h3>{sec.title}</h3>
            {sec.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        ))
      }
    </div>
  </section>

  <section class="section faq wrap" id="questions">
    <div>
      <h2>{practice.faq.title}</h2>
    </div>
    <div class="faq-list">
      {
        practice.faq.items.map((q: { question: string; answer: string[]; link?: { label: string; href: string } }) => (
          <section>
            <h3>{q.question}</h3>
            {q.answer.map((a) => <p>{a}</p>)}
            {q.link && <TextLink href={q.link.href} label={q.link.label} />}
          </section>
        ))
      }
    </div>
  </section>

  <script>
    import '../scripts/architecture-controls.ts';
  </script>
</Base>
