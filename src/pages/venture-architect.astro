---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { getSite } from '../lib/site';
import { parseMarkdown } from '../lib/home';
import type { Node } from '../lib/home';
import { inlineHtml } from '../lib/inline';

const site = await getSite();
const meta = site.meta.essay;
const entry = await getEntry('pages', 'venture-architect');
const data = entry!.data;
const nodes = parseMarkdown(entry?.body ?? '');

const h1 = nodes.find((n) => n.type === 'h1');
const firstH2 = nodes.findIndex((n) => n.type === 'h2');
const pre = firstH2 === -1 ? nodes : nodes.slice(0, firstH2);
const rest = firstH2 === -1 ? [] : nodes.slice(firstH2);

type Sec = { heading: string; nodes: Node[] };
const sections: Sec[] = [];
for (const n of rest) {
  if (n.type === 'h2') sections.push({ heading: n.text, nodes: [] });
  else sections.at(-1)?.nodes.push(n);
}

const preParas = pre.filter((n) => n.type === 'p') as Extract<Node, { type: 'p' }>[];
const byline = preParas[0]?.text ?? '';
const definition = preParas[1]?.text ?? '';
const introCols = preParas.slice(2);

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const pad = (i: number) => String(i + 1).padStart(2, '0');
const numbered = sections.filter((s) => s.heading.toLowerCase() !== 'closing');
const closing = sections.find((s) => s.heading.toLowerCase() === 'closing');
const closingP = closing?.nodes.find((n) => n.type === 'p');
const closingLinks = closing?.nodes.find((n) => n.type === 'links');

const parasOf = (s: Sec) => s.nodes.filter((n): n is Extract<Node, { type: 'p' }> => n.type === 'p');
const isFaq = (s: Sec) => s.nodes.some((n) => n.type === 'h3');
function faqPairs(sec: Sec) {
  const out: { q: string; a: string }[] = [];
  for (const n of sec.nodes) {
    if (n.type === 'h3') out.push({ q: n.text, a: '' });
    else if (n.type === 'p' && out.length) out.at(-1)!.a = n.text;
  }
  return out;
}
---

<Base
  title={meta.title}
  description={meta.description}
  sheet={data.sheet}
  revision={data.revision}
  revised={data.revised}
>
  <article>
    <section class="section pad-x" style="padding-bottom:clamp(40px,5vw,72px)">
      {h1?.type === 'h1' && <h1 class="display-xl" style="max-width:12ch">{h1.text}</h1>}
      <div class="byline">
        <p>{byline}</p>
        <p class="soft" data-diff-skip>
          Published <span class="todo">{data.revised}</span>. Revision {data.revision}.
        </p>
      </div>
      <nav class="toc" aria-label="On this page" data-diff-skip>
        <ol>
          {
            numbered.map((s, i) => (
              <li>
                <a href={`#${slug(s.heading)}`}>
                  <span class="n">{pad(i)}</span>
                  {s.heading}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>

    <section class="slab pad-x" style="padding-block:clamp(56px,7vw,112px)">
      <p
        style="font-weight:500;font-size:clamp(26px,2.8vw,48px);line-height:1.12;letter-spacing:-0.025em;max-width:26ch;text-wrap:balance"
      >
        {definition}
      </p>
      <div class="cols2" style="margin-top:clamp(36px,4vw,56px);color:var(--invsoft)">
        {introCols.map((p) => <p class="body" set:html={inlineHtml(p.text)} />)}
      </div>
    </section>

    <div class="pad-x">
      {
        numbered.map((s, i) => (
          <section class="section section--rule split" id={slug(s.heading)}>
            <div class="sticky">
              <p class="stack-num">{pad(i)}</p>
              <h2 class="h2">{s.heading}</h2>
            </div>
            <div class="body measure">
              {isFaq(s) ? (
                <dl class="faq">
                  {faqPairs(s).map((qa) => (
                    <div>
                      <dt>{qa.q}</dt>
                      <dd set:html={inlineHtml(qa.a)} />
                    </div>
                  ))}
                </dl>
              ) : parasOf(s).length === 1 ? (
                <p
                  style="font-size:clamp(22px,2vw,34px);line-height:1.25;font-weight:500;letter-spacing:-0.015em;max-width:30ch;text-wrap:pretty"
                  set:html={inlineHtml(parasOf(s)[0].text)}
                />
              ) : (
                parasOf(s).map((p) => <p set:html={inlineHtml(p.text)} />)
              )}
            </div>
          </section>
        ))
      }

      {
        closing && (
          <section class="section section--rule">
            <p class="h2-lg" style="max-width:16ch">
              {closingP?.type === 'p' && closingP.text}
            </p>
            {closingLinks?.type === 'links' && closingLinks.links[0] && (
              <div style="margin-top:36px">
                <a class="btn" href={closingLinks.links[0].href}>
                  {closingLinks.links[0].label}
                </a>
              </div>
            )}
          </section>
        )
      }
    </div>
  </article>
</Base>
