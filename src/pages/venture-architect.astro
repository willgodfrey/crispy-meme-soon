---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import '../styles/practice.css';
import { practice, common, getStages } from '../lib/content';
// Injected raw so Astro does not extract/scope the SVG's internal <style>
// (that stripping is what made the model render solid black).
import ventureLayersSvg from '../svg/venture-layers.svg?raw';

const stages = getStages(practice.engagement.stageIds);
const layers = practice.layers.items as {
  id: string;
  title: string;
  question: string;
  body: string;
  joint: string;
}[];
---

<Base title={practice.seo.title} description={practice.seo.description}>
  <section class="practice-hero wrap">
    <div class="practice-title">
      <p class="page-kicker">{practice.hero.eyebrow}</p>
      <h1>{practice.hero.titleLines.map((l: string, i: number) => (i ? [<br />, l] : l))}</h1>
      <p class="practice-summary">{practice.hero.body}</p>
      <div class="hero-links">
        <TextLink href={practice.hero.primaryLink.href} label={practice.hero.primaryLink.label} />
        <TextLink href={practice.hero.secondaryLink.href} label={practice.hero.secondaryLink.label} />
      </div>
    </div>
    <div>
      <div class="layer-art" set:html={ventureLayersSvg}></div>
      <div class="layer-controls case-controls js-controls" role="group" aria-label={common.accessibility.diagramSelector}>
        {
          layers.map((it, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`layer-${it.id}`} data-plane={it.id} data-target={`layer-${it.id}`}>
              {it.title}
            </button>
          ))
        }
      </div>
      <div class="layer-panels">
        {
          layers.map((it) => (
            <div class="layer-panel" id={`layer-${it.id}`}>
              <h2>{it.question}</h2>
              <p>{it.body}</p>
              <p class="joint">{it.joint}</p>
            </div>
          ))
        }
      </div>
      <p class="model-caption">{practice.layers.caption}</p>
    </div>
  </section>

  <section class="joins wrap">
    <h2>{practice.layers.title}</h2>
    <p>{practice.layers.body}</p>
  </section>

  <section class="section wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{practice.decisions.eyebrow}</p>
        <h2>{practice.decisions.title}</h2>
      </div>
      <p>{practice.decisions.body}</p>
    </div>
    <ul class="decision-list">
      {practice.decisions.items.map((d: string) => <li>{d}</li>)}
    </ul>
  </section>

  <section class="section engagement wrap" id={practice.engagement.id}>
    <div class="section-heading">
      <div>
        <p class="eyebrow">{practice.engagement.eyebrow}</p>
        <h2>{practice.engagement.title}</h2>
      </div>
      <p>{practice.engagement.body}</p>
    </div>
    <div class="stage-spreads">
      {
        stages.map((s) => (
          <article>
            <p class="phase-number">{s.number}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <h4>{s.deliverable.title}</h4>
            <ul>{s.deliverable.items.map((it: string) => <li>{it}</li>)}</ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section modes wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{practice.modes.eyebrow}</p>
        <h2>{practice.modes.title}</h2>
      </div>
      <p>{practice.modes.body}</p>
    </div>
    <div class="mode-grid">
      {
        practice.modes.items.map((m: { title: string; body: string; duration: string; location: string }) => (
          <article>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
            <p>{m.duration}</p>
            <p>{m.location}</p>
          </article>
        ))
      }
    </div>
    <div class="modes-foot">
      <p>{practice.modes.note}</p>
      <TextLink href={practice.modes.link.href} label={practice.modes.link.label} />
    </div>
  </section>

  <section class="section standards wrap">
    <div>
      <p class="eyebrow">{practice.standards.eyebrow}</p>
      <h2>{practice.standards.title}</h2>
      <ul>{practice.standards.items.map((s: string) => <li>{s}</li>)}</ul>
    </div>
    <div>
      <h3>{practice.standards.boundaryTitle}</h3>
      <ul>{practice.standards.boundaries.map((b: string) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="section definition wrap" id={practice.definition.id}>
    <aside>
      <p class="eyebrow">{practice.definition.eyebrow}</p>
      <h2>{practice.definition.title}</h2>
      <p>{practice.definition.byline}</p>
      <TextLink href="#questions" label={practice.faq.title} />
    </aside>
    <div class="reading">
      <p class="definition-lead">{practice.definition.introduction}</p>
      {
        practice.definition.sections.map((sec: { title: string; paragraphs: string[] }) => (
          <section>
            <h3>{sec.title}</h3>
            {sec.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        ))
      }
    </div>
  </section>

  <section class="section faq wrap" id="questions">
    <div>
      <h2>{practice.faq.title}</h2>
    </div>
    <div class="faq-list">
      {
        practice.faq.items.map((q: { question: string; answer: string[]; link?: { label: string; href: string } }) => (
          <section>
            <h3>{q.question}</h3>
            {q.answer.map((a) => <p>{a}</p>)}
            {q.link && <TextLink href={q.link.href} label={q.link.label} />}
          </section>
        ))
      }
    </div>
  </section>

  <script>
    import '../scripts/architecture-controls.ts';
  </script>
</Base>
