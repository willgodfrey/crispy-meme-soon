---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import CommissionFigure from '../components/CommissionFigure.astro';
import ServiceOverview from '../components/ServiceOverview.astro';
import '../styles/practice.css';
import '../styles/services-page.css';
import { commissions, getStages } from '../lib/content';

const { hero, flagship, focused, portfolio, conversation, faq, labels } = commissions;
const stages = getStages(flagship.stageIds);
---

<Base title={commissions.seo.title} description={commissions.seo.description} bodyClass="commissions-page">
  <section class="services-opening wrap">
    <div>
      <p class="intro">{hero.eyebrow}</p>
      <h1>{hero.titleLines.map((line, index) => index ? [<br />, line] : line)}</h1>
    </div>
    <div class="services-opening-copy">
      <p class="services-lead">{hero.body}</p>
      <div class="hero-links">
        <TextLink {...hero.primaryLink} />
        <TextLink {...hero.secondaryLink} />
      </div>
      <p class="services-helper">{hero.helper}</p>
    </div>
  </section>

  <ServiceOverview local heading={false} />

  <section class="section flagship wrap" id={flagship.id}>
    <div class="flagship-heading service-flagship-heading">
      <div>
        <p class="eyebrow">{flagship.eyebrow}</p>
        <h2>{flagship.title}</h2>
        <dl class="service-description">
          <dt>{labels.when}</dt><dd>{flagship.when}</dd>
          <dt>{labels.work}</dt><dd>{flagship.body}</dd>
        </dl>
      </div>
      <CommissionFigure {...hero} />
    </div>
    <div class="commission-stages">
      {stages.map((stage) => (
        <article>
          <span class="stage-number">{stage.number}</span>
          <h3>{stage.title}</h3>
          <p>{stage.body}</p>
          <p class="stage-record">{stage.deliverable.title}</p>
        </article>
      ))}
    </div>
    <div class="flagship-detail">
      <div>
        <h3 class="small-heading">{labels.engagementModes}</h3>
        <div class="commission-modes">
          {flagship.modes.map((mode) => (
            <article><h4>{mode.title}</h4><p>{mode.body}</p></article>
          ))}
        </div>
      </div>
      <div>
        <h3 class="small-heading">{flagship.deliverableTitle}</h3>
        <ul class="clean-list" role="list">{flagship.deliverables.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
    <div class="flagship-foot">
      <div class="service-boundary"><h3 class="small-heading">{labels.client}</h3><p>{flagship.boundary}</p></div>
      <div class="hero-links"><TextLink {...flagship.link} /><TextLink {...flagship.evidenceLink} /></div>
    </div>
  </section>

  <section id={focused.id}>
    <div class="focused-heading wrap"><h2>{focused.title}</h2><p>{focused.body}</p></div>
    {focused.items.map((offer, index) => (
      <article class:list={['commission-spread', 'wrap', { reverse: index % 2 === 1 }]} id={offer.id}>
        <div class="commission-copy">
          <h3>{offer.name}</h3>
          <p class="service-situation">{offer.situation}</p>
          <dl class="offer-detail">
            <dt>{labels.when}</dt><dd>{offer.when}</dd>
            <dt>{labels.work}</dt><dd>{offer.body}</dd>
            <dt>{labels.decision}</dt><dd>{offer.decision}</dd>
            <dt>{labels.deliverables}</dt>
            <dd><ul class="clean-list" role="list">{offer.deliverables.map((item) => <li>{item}</li>)}</ul></dd>
            <dt>{labels.client}</dt><dd class="scope-note">{offer.scopeNote}</dd>
          </dl>
          <TextLink {...offer.link} />
        </div>
        <CommissionFigure {...offer} />
      </article>
    ))}
  </section>

  <section class="portfolio-session wrap" id={portfolio.id}>
    <div><p class="eyebrow">{portfolio.eyebrow}</p><h2>{portfolio.title}</h2><TextLink {...portfolio.link} /></div>
    <dl class="service-description">
      <dt>{labels.when}</dt><dd>{portfolio.when}</dd>
      <dt>{labels.work}</dt><dd>{portfolio.body}</dd>
      <dt>{labels.deliverables}</dt><dd>{portfolio.deliverable}</dd>
      <dt>{labels.client}</dt><dd>{portfolio.scopeNote}</dd>
    </dl>
  </section>

  <section class="section conversation wrap" id={conversation.id}>
    <div class="section-heading"><h2>{conversation.title}</h2><p>{conversation.body}</p></div>
    <ol class="conversation-steps" role="list">
      {conversation.steps.map((step) => <li><h3>{step.title}</h3><p>{step.body}</p></li>)}
    </ol>
    <TextLink {...conversation.link} />
  </section>

  <section class="section faq commission-faq wrap">
    <h2>{faq.title}</h2>
    <div class="faq-list">
      {faq.items.map((item) => <section><h3>{item.question}</h3>{item.answer.map((answer) => <p>{answer}</p>)}</section>)}
    </div>
  </section>
</Base>
