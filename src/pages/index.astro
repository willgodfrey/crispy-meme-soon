---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import '../styles/practice.css';
import { home, common, getCases, getStages, diagramSrc } from '../lib/content';

const cases = getCases(home.selectedWork.caseIds);
const stages = getStages(home.process.stageIds);
const sw = home.selectedWork;
const AP = '/images/architecture-practice/assembly';
const avif = `${AP}-640.avif 640w, ${AP}-960.avif 960w, ${AP}-1536.avif 1536w`;
const webp = `${AP}-640.webp 640w, ${AP}-960.webp 960w, ${AP}-1536.webp 1536w`;
---

<Base title={home.seo.title} description={home.seo.description}>
  <section class="hero">
    <picture>
      <source type="image/avif" srcset={avif} sizes="100vw" />
      <source type="image/webp" srcset={webp} sizes="100vw" />
      <img
        class="hero-image"
        src={`${AP}-1536.jpg`}
        alt={home.hero.imageAlt}
        width="1536"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero-content wrap">
      <p class="intro">{home.hero.eyebrow}</p>
      <h1>{home.hero.titleLines.map((l, i) => (i ? [<br />, l] : l))}</h1>
      <p class="hero-copy">{home.hero.body}</p>
      <div class="hero-links">
        <TextLink href={home.hero.primaryLink.href} label={home.hero.primaryLink.label} />
        <TextLink href={home.hero.secondaryLink.href} label={home.hero.secondaryLink.label} />
      </div>
    </div>
    <p class="image-caption">{home.hero.imageCaption}</p>
  </section>

  <section class="proof wrap" aria-label={home.proof.label}>
    <h2 class="sr-only">{home.proof.label}</h2>
    {
      home.proof.items.map((item: { title: string; body: string }) => (
        <p>
          <strong>{item.title}</strong>
          {item.body}
        </p>
      ))
    }
  </section>

  <section class="section work wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{sw.eyebrow}</p>
        <h2>{sw.title}</h2>
      </div>
      <p>{sw.body}</p>
    </div>

    <div class="case-controls js-controls" role="group" aria-label={common.accessibility.workSelector}>
      {
        cases.map((c, i) => (
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`work-${c.id}`} data-target={`work-${c.id}`}>
            {c.category}
          </button>
        ))
      }
    </div>

    <div class="case-stack">
      {
        cases.map((c) => (
          <div class="case-panel work-layout" id={`work-${c.id}`}>
            <div class="work-visual">
              <img src={diagramSrc(c.visualId)} alt={c.visualAlt} width="520" height="300" loading="lazy" />
              <span class="visual-note">{sw.visualLabel}</span>
            </div>
            <div class="case-info">
              <p class="role">{c.role}</p>
              <h3>{c.title}</h3>
              <p>{c.summary}</p>
              <p class="fact">{c.evidence}</p>
              <TextLink href={`/work/#${c.id}`} label={sw.caseLinkLabel} />
            </div>
          </div>
        ))
      }
    </div>

    <div class="all-work">
      <TextLink href={sw.moreLink.href} label={sw.moreLink.label} />
    </div>
  </section>

  <section class="section process wrap">
    <div class="process-grid">
      <div class="process-head">
        <p class="eyebrow">{home.process.eyebrow}</p>
        <h2>{home.process.title}</h2>
        <p>{home.process.body}</p>
        <div class="phase-controls js-controls" role="group" aria-label={common.accessibility.stageSelector}>
          {
            stages.map((s, i) => (
              <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`stage-${s.id}`} data-target={`stage-${s.id}`}>
                {s.title}
              </button>
            ))
          }
        </div>
        <TextLink class="process-link" href={home.process.link.href} label={home.process.link.label} />
      </div>

      <div class="sheet-stack">
        {
          stages.map((s) => (
            <div class="stage-panel" id={`stage-${s.id}`}>
              <p class="phase-description">{s.body}</p>
              <div class="sheet-area">
                <div class="sheet">
                  <div class="sheet-top">
                    <b>{common.siteName}</b>
                    <span>{common.descriptor}<br />{s.deliverable.eyebrow}</span>
                  </div>
                  <div class="sheet-name">{s.deliverable.title}</div>
                  <div class="sheet-lines">
                    {s.deliverable.items.map((it: string, i: number) => [
                      <span>{String(i + 1).padStart(2, '0')}</span>,
                      <i>{it}</i>,
                    ])}
                  </div>
                  <div class="sheet-seal">{s.deliverable.seal}</div>
                  <div class="sheet-foot">{s.deliverable.footer}</div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section personal wrap">
    <div class="portrait">
      <img
        src={common.portrait.path}
        alt={common.portrait.alt}
        width="122"
        height="148"
        loading="lazy"
      />
      <p>
        <strong>{home.personal.name}</strong>
        {home.personal.role}<br />{home.personal.location}
      </p>
    </div>
    <div>
      <blockquote>{home.personal.quote}</blockquote>
      <p class="byline">{home.personal.body}</p>
      <TextLink href={home.personal.link.href} label={home.personal.link.label} />
    </div>
  </section>
</Base>
