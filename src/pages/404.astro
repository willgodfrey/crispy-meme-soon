---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import AssemblyPicture from '../components/AssemblyPicture.astro';
import '../styles/inner.css';
import { notFound } from '../lib/content';
const h = notFound.hero;
---

<Base
  title={notFound.seo.title}
  description={notFound.seo.description}
  invitation={false}
  noindex={true}
  bodyClass="inner-page"
>
  <section class="error-layout wrap">
    <div>
      <p class="page-kicker">{h.eyebrow}</p>
      <h1>{h.title}</h1>
      <p class="error-copy">{h.body}</p>
      <div class="error-links">
        <TextLink href={h.primaryLink.href} label={h.primaryLink.label} />
        <TextLink href={h.secondaryLink.href} label={h.secondaryLink.label} />
      </div>
    </div>
    <div class="error-art">
      <AssemblyPicture sizes="(max-width: 620px) 90vw, 45vw" />
    </div>
  </section>
</Base>
