---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const nf = site.notFound;
const meta = site.meta.notFound;
---

<Base title={meta.title} sheet="404">
  <h1>{nf.headline}</h1>
  <p>{nf.body}</p>
  <p>
    {
      nf.links.map((link, i) => (
        <>
          {i > 0 && <span>. </span>}
          <a href={link.href}>{link.label}</a>
        </>
      ))
    }
  </p>
</Base>
