---
import Base from '../layouts/Base.astro';
import TextLink from '../components/TextLink.astro';
import '../styles/inner.css';
import { work, common, diagramSrc } from '../lib/content';
import type { WorkCase } from '../lib/content';

const cases = work.cases as WorkCase[];
---

<Base title={work.seo.title} description={work.seo.description} bodyClass="inner-page">
  <section class="inner-intro work-intro wrap">
    <div>
      <p class="page-kicker">{work.hero.eyebrow}</p>
      <h1>{work.hero.titleLines.map((l: string, i: number) => (i ? [<br />, l] : l))}</h1>
    </div>
    <div>
      <p class="lead">{work.hero.body}</p>
      <TextLink href={work.hero.primaryLink.href} label={work.hero.primaryLink.label} />
    </div>
  </section>

  <nav class="work-index wrap" id={work.index.id} aria-label={work.index.label}>
    {work.index.items.map((it: { label: string; href: string }) => <a href={it.href}>{it.label}</a>)}
  </nav>

  {
    cases.map((c, i) => (
      <section class:list={['case-study wrap', { 'is-reversed': i % 2 === 1 }]} id={c.id}>
        <div class="case-grid">
          <div class="case-copy">
            <p class="case-role">{c.role}</p>
            <h2>{c.title}</h2>
            <p class="case-summary">{c.summary}</p>
            <p class="case-context">{c.context}</p>
          </div>
          <figure class="case-art">
            <img src={diagramSrc(c.visualId)} alt={c.visualAlt} width="520" height="300" loading="lazy" />
            <figcaption>{c.visualCaption}</figcaption>
          </figure>
        </div>
        <div class="case-details">
          <div>
            <h3>{common.caseLabels.design}</h3>
            <p>{c.design}</p>
          </div>
          <div>
            <h3>{common.caseLabels.evidence}</h3>
            <p>{c.evidence}</p>
          </div>
        </div>
        {c.link && <TextLink href={c.link.href} label={c.link.label} />}
      </section>
    ))
  }

  <section class="earlier wrap">
    <div>
      <p class="page-kicker">{work.earlier.eyebrow}</p>
      <h2>{work.earlier.title}</h2>
    </div>
    <div>
      <p>{work.earlier.body}</p>
      <TextLink href={work.earlier.link.href} label={work.earlier.link.label} />
    </div>
  </section>
</Base>
