---
import type { SiteData } from '../lib/site';
interface Props {
  site: SiteData;
  sheet?: string;
}
const { site, sheet } = Astro.props;
const { titleBlock, linkedin } = site;
const l = titleBlock.labels;
---

<footer class="title-block">
  <dl>
    <div>
      <dt>Practice</dt>
      <dd>{titleBlock.practice}</dd>
    </div>
    <div>
      <dt>{l.sheet}</dt>
      <dd>{sheet ?? '—'}</dd>
    </div>
    <div>
      <dt>{l.contact}</dt>
      <dd><a href="/contact/">{site.closingLink}</a></dd>
    </div>
    <div>
      <dt>{l.elsewhere}</dt>
      <dd><a href={linkedin} rel="noopener">{titleBlock.elsewhere}</a></dd>
    </div>
  </dl>
</footer>
