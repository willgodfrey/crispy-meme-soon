---
// Phase 1 placeholder nav. Wired to content/site.md in Phase 2.
const nav = [
  { label: 'Venture architecture', href: '/venture-architect/' },
  { label: 'Work', href: '/work/' },
  { label: 'About', href: '/about/' },
  { label: 'Start a conversation', href: '/contact/' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/">Will Godfrey</a>
  <nav aria-label="Primary">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
