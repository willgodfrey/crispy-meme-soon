---
import type { Node } from '../lib/home';
interface Props {
  nodes: Node[];
}
const { nodes } = Astro.props;
---

{
  nodes.map((n) => {
    if (n.type === 'h2') return <h2>{n.text}</h2>;
    if (n.type === 'p') return <p>{n.text}</p>;
    if (n.type === 'list' && n.ordered)
      return (
        <ol class="steps">
          {n.items.map((it) => (
            <li>{it}</li>
          ))}
        </ol>
      );
    if (n.type === 'list')
      return (
        <ul class="ruled">
          {n.items.map((it) => (
            <li>{it}</li>
          ))}
        </ul>
      );
    if (n.type === 'links')
      return (
        <p class="link-row">
          {n.links.map((l, i) => (
            <a class:list={['pill', { 'pill--solid': i === 0 }]} href={l.href}>
              {l.label}
            </a>
          ))}
        </p>
      );
    if (n.type === 'table')
      return (
        <div class="compare">
          <table>
            <thead>
              <tr>{n.head.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {n.rows.map((r) => (
                <tr>
                  {r.map((c, ci) => (ci === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    return null;
  })
}
