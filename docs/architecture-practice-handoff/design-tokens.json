{
  "version": "1.0",
  "status": "Design specification, not production code",
  "color": {
    "paper": "#FAFAF7",
    "chalk": "#ECEDE9",
    "ink": "#252729",
    "wine": "#622B3D",
    "muted": "#5B6060",
    "line": "#CDD0CA",
    "workSurface": "#E6E9E5",
    "processSurface": "#E9EAE5"
  },
  "typography": {
    "sans": {
      "family": "Manrope",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "file": "assets/fonts/manrope-latin-variable.woff2"
    },
    "reading": {
      "family": "Newsreader",
      "weight": 400,
      "opticalSize": "6..72",
      "file": "assets/fonts/newsreader-latin-variable.woff2"
    },
    "hero": {
      "desktop": "clamp(72px,6.8vw,104px)",
      "mobile": "clamp(48px,16vw,64px)",
      "weight": 500,
      "lineHeight": 1.01,
      "letterSpacing": "-0.065em"
    },
    "pageTitle": {
      "desktop": "clamp(54px,6vw,88px)",
      "mobile": "clamp(42px,12vw,60px)",
      "weight": 500,
      "lineHeight": 1.03,
      "letterSpacing": "-0.055em"
    },
    "sectionTitle": {
      "desktop": "clamp(34px,4.2vw,62px)",
      "mobile": "34px",
      "weight": 500,
      "lineHeight": 1.1,
      "letterSpacing": "-0.055em"
    },
    "body": {
      "size": "17px",
      "lineHeight": 1.65,
      "maxWidth": "60ch"
    },
    "readingBody": {
      "size": "21px",
      "lineHeight": 1.55,
      "maxWidth": "62ch"
    },
    "ui": {
      "size": "13px",
      "weight": 600,
      "lineHeight": 1.6
    },
    "caption": {
      "size": "12px",
      "lineHeight": 1.5
    }
  },
  "layout": {
    "widePageMax": "none",
    "sidePadding": "clamp(20px,5vw,96px)",
    "sectionDesktop": 104,
    "sectionTablet": 76,
    "sectionMobile": 60,
    "gridColumns": 12,
    "gridGapDesktop": 32,
    "gridGapMobile": 24,
    "breakpoints": {
      "phoneMax": 620,
      "tabletMax": 900
    },
    "headerHeightDesktop": 94,
    "headerHeightMobile": "auto; content wraps",
    "heroMinHeightDesktop": 650,
    "heroMinHeightPhone": 810
  },
  "interaction": {
    "focusOutline": "3px solid #622B3D",
    "focusOffset": 4,
    "minimumTarget": 44,
    "transitionMs": 120,
    "automaticMotion": false,
    "reducedMotion": "Disable animated transitions and smooth scroll"
  },
  "shape": {
    "cornerRadius": 0,
    "portraitRadius": 2,
    "documentRotationDesktop": "-4deg",
    "documentShadow": "14px 24px 28px #25272915",
    "cardShadows": "none"
  }
}
